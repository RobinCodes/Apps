/* lyndon.rc — icon, version stamp and the manifest. */

#include <winver.h>

APPICON ICON "../data/icons/lyndon.ico"

/* RT_MANIFEST = 24, CREATEPROCESS_MANIFEST_RESOURCE_ID = 1 */
1 24 "lyndon.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    0,1,0,0
  PRODUCTVERSION 0,1,0,0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Lyndon"
      VALUE "FileDescription",  "Lyndon Browser"
      VALUE "FileVersion",      "0.1.0"
      VALUE "InternalName",     "lyndon"
      VALUE "OriginalFilename", "lyndon.exe"
      VALUE "ProductName",      "Lyndon"
      VALUE "ProductVersion",   "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
