[Desktop Entry]
Type=Application
Name=Notedown
GenericName=Markdown editor
Comment=Write Markdown on the left, watch the page appear on the right
Exec=/home/robin/.local/bin/notedown %F
Icon=notedown
Terminal=false
Categories=Office;WordProcessor;
MimeType=text/markdown;text/x-markdown;text/plain;
Keywords=markdown;md;notes;editor;writing;readme;
StartupNotify=true
StartupWMClass=com.robin.Notedown
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=/home/robin/.local/bin/notedown --new-window
