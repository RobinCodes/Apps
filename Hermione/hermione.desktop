[Desktop Entry]
Type=Application
Name=Hermione
GenericName=File manager
Comment=Browse, search and tidy up the files on this machine
Exec=/home/robin/.local/bin/hermione %U
Icon=hermione
Terminal=false
Categories=Utility;FileTools;FileManager;
Keywords=files;folders;browse;manager;explorer;search;duplicates;archive;
MimeType=inode/directory;x-scheme-handler/file;
StartupNotify=true
StartupWMClass=com.robin.Hermione
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=/home/robin/.local/bin/hermione --new-window
