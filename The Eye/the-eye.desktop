[Desktop Entry]
Type=Application
Name=The Eye
GenericName=Photo and video viewer
Comment=Look at photographs and video, and grade them while you do
Exec=/home/robin/.local/bin/the-eye %F
Icon=the-eye
Terminal=false
Categories=Graphics;Viewer;AudioVideo;Player;Photography;
